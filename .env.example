# ==============================================================================
# TRACEANVAYA ENVIRONMENT CONFIGURATION
# ==============================================================================

# Backend Server
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AI Provider Configuration
# Supported models: gemini-2.0-flash, gemini-1.5-pro, gemini-1.5-flash, openai:gpt-4o, etc.
AI_PROVIDER=gemini
AI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
# Fallback / Alternative OpenAI configuration if using OpenAI
OPENAI_API_KEY=

# Database Configuration
# Default development uses async SQLite; production uses PostgreSQL
DATABASE_URL=sqlite+aiosqlite:///./traceanvaya.db
# PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://traceanvaya:traceanvaya@localhost:5432/traceanvaya

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_COPILOT_RUNTIME_URL=http://localhost:3000/api/copilotkit
