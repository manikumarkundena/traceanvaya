# ==============================================================================
# TRACEANVAYA ENVIRONMENT CONFIGURATION
# ==============================================================================

# Backend Server
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AI Provider Configuration
# Supported models: gemini-3.5-flash-lite, gemini-2.5-flash, openai:gpt-4o
AI_PROVIDER=gemini
AI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
# Fallback / Alternative OpenAI configuration if using OpenAI
OPENAI_API_KEY=
RATE_LIMIT_PER_MINUTE=30

# Database Configuration
# Default development uses async SQLite; production uses PostgreSQL
DATABASE_URL=sqlite+aiosqlite:///./traceanvaya.db
# PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://traceanvaya:traceanvaya@localhost:5432/traceanvaya

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
BACKEND_AGENT_URL=http://127.0.0.1:8000/agent
